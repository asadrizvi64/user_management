# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_training
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-development-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App settings
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:8002,http://localhost:3001,http://localhost:8001

# File storage
UPLOAD_DIR=storage
MAX_FILE_SIZE=104857600

# Training
MAX_TRAINING_IMAGES=150
DEFAULT_TRAINING_RESOLUTION=512
CUDA_VISIBLE_DEVICES=0

# Database credentials
DB_USER=postgres
DB_PASSWORD=postgres

# ComfyUI Configuration
# Set this to your ComfyUI models directory path
# Example: C:/ComfyUI/models or /home/user/ComfyUI/models
# If not set, the system will search for ComfyUI in common locations
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_MODELS_PATH=
# ============================================================
# ComfyUI FluxTrainer - .gitignore
# ============================================================

# ==== COMFYUI INSTALLATION (IGNORE ENTIRE THING) ====
ComfyUI_FluxTrainer/

# ==== ALTERNATIVE: If you want to keep some files ====
# Uncomment below and comment out the line above

# # Python embedded environment
# ComfyUI_FluxTrainer/python_embeded/
# 
# # ComfyUI core (it's a separate git repo)
# ComfyUI_FluxTrainer/ComfyUI/
# 
# # Models (huge files)
# ComfyUI_FluxTrainer/ComfyUI/models/
# *.safetensors
# *.ckpt
# *.pt
# *.pth
# *.bin
# *.sft
# 
# # Outputs and generated files
# ComfyUI_FluxTrainer/ComfyUI/output/
# ComfyUI_FluxTrainer/ComfyUI/temp/
# ComfyUI_FluxTrainer/datasets/
# 
# # Custom nodes (separate git repos)
# ComfyUI_FluxTrainer/ComfyUI/custom_nodes/ComfyUI-FluxTrainer/
# ComfyUI_FluxTrainer/ComfyUI/custom_nodes/ComfyUI-KJNodes/
# ComfyUI_FluxTrainer/ComfyUI/custom_nodes/rgthree-comfy/
# 
# # Logs and cache
# ComfyUI_FluxTrainer/ComfyUI/user/
# ComfyUI_FluxTrainer/ComfyUI/__pycache__/
# **/__pycache__/
# *.pyc
# *.pyo
# 
# # Temp files
# *.7z
# *.zip
# *.tar.gz
# PortableGit/
# temp/

# ==== GENERAL PYTHON ====

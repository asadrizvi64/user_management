# Database Configuration
DATABASE_URL=sqlite:///./product_training.db

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Frontend URLs
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3001,http://localhost:3000,http://localhost:5173

# File Upload
UPLOAD_DIR=storage
MAX_FILE_SIZE=10485760

# Training Settings
MAX_TRAINING_IMAGES=150
DEFAULT_TRAINING_RESOLUTION=512

# GPU Settings (optional)
CUDA_VISIBLE_DEVICES=0

# Debug Mode
DEBUG=false

# ComfyUI Configuration
# URL for ComfyUI API (default: http://127.0.0.1:8188)
COMFYUI_URL=http://127.0.0.1:8188

# Path to ComfyUI models directory (optional)
# If not set, the system will search for ComfyUI in common locations
# Windows example: COMFYUI_MODELS_PATH=C:/ComfyUI/models
# Linux example: COMFYUI_MODELS_PATH=/home/user/ComfyUI/models
# Mac example: COMFYUI_MODELS_PATH=/Users/username/ComfyUI/models
COMFYUI_MODELS_PATH=

# Cloud GPU Services (optional)
# fal.ai API key for cloud inference fallback
FAL_KEY=

# RunPod settings (optional)
RUNPOD_API_KEY=
RUNPOD_ENABLED=false

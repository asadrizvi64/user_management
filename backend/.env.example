# Database Configuration
DATABASE_URL=sqlite:///./product_training.db

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Frontend URLs
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3001,http://localhost:3000,http://localhost:5173

# File Upload
UPLOAD_DIR=storage
MAX_FILE_SIZE=10485760

# Training Settings
MAX_TRAINING_IMAGES=150
DEFAULT_TRAINING_RESOLUTION=512

# GPU Settings (optional)
CUDA_VISIBLE_DEVICES=0

# Debug Mode
DEBUG=false

# App Configuration
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./product_training.db

# File Storage
UPLOAD_DIR=storage
MAX_FILE_SIZE=10485760

# CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Training Settings
MAX_TRAINING_IMAGES=150
DEFAULT_TRAINING_RESOLUTION=512

# GPU Settings
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_THRESHOLD=0.8

# ===== Cloud GPU Services =====

# fal.ai Configuration
# Get your API key from: https://fal.ai/dashboard/keys
FAL_KEY=
FAL_DEPLOYMENT_ENABLED=false

# RunPod Configuration
# Get your API key from: https://runpod.io/console/user/settings
RUNPOD_API_KEY=
RUNPOD_ENABLED=false
RUNPOD_GPU_TYPE=NVIDIA RTX A4000
RUNPOD_DOCKER_IMAGE=runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel

# ===== How to Use Cloud GPU Services =====

# 1. fal.ai Setup:
#    - Sign up at https://fal.ai
#    - Go to Dashboard > Keys and create a new API key
#    - Set FAL_KEY to your API key
#    - Set FAL_DEPLOYMENT_ENABLED=true to enable fal.ai deployment
#    - After training, use the /deploy-to-fal endpoint to deploy your LoRA
#    - Generate images using the /generate-with-fal endpoint

# 2. RunPod Setup:
#    - Sign up at https://runpod.io
#    - Go to Settings > API Keys and create a new API key
#    - Set RUNPOD_API_KEY to your API key
#    - Set RUNPOD_ENABLED=true to enable automatic GPU fallback
#    - Choose your GPU type with RUNPOD_GPU_TYPE (options: "NVIDIA RTX A4000", "NVIDIA A100", etc.)
#    - When your local GPU is busy (>80% memory), training will automatically use RunPod

# 3. GPU Threshold:
#    - GPU_MEMORY_THRESHOLD=0.8 means if local GPU memory usage > 80%, use RunPod
#    - Adjust this value based on your needs (0.0 to 1.0)
#    - Lower value = more likely to use RunPod
#    - Higher value = prefer local GPU even when busy

# ===== Integration Workflow =====

# Option A: Local Training + fal.ai Deployment
# 1. Train locally (default)
# 2. Deploy to fal.ai: POST /training/deploy-to-fal
# 3. Generate images: POST /training/generate-with-fal

# Option B: Automatic RunPod Fallback
# 1. Enable RunPod: RUNPOD_ENABLED=true
# 2. Start training: POST /training/start
# 3. System automatically uses RunPod if local GPU is busy
# 4. Monitor with: GET /training/gpu-status

# Option C: Full Cloud Workflow
# 1. Train on RunPod (when local GPU busy)
# 2. Deploy to fal.ai for inference
# 3. Use fal.ai for all image generation (no local GPU needed)
